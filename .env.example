# =============================================================================
# Interview Buddy - 環境変数テンプレート
# このファイルをコピーして .env.local を作成し、実際の値を入力してください
#   cp .env.example .env.local
# 本番用の秘匿値は必ず安全に保管してください
# =============================================================================

# -----------------------------------------------------------------------------
# Database (PostgreSQL) - Docker Compose 用（ローカル開発のみ）
# docker-compose.yml の environment セクションと値を一致させること
# AWS RDS を使う場合はこの3変数は不要で DATABASE_URL だけ設定する
# -----------------------------------------------------------------------------
POSTGRES_USER=interview_buddy
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=interview_buddy_dev

# -----------------------------------------------------------------------------
# Prisma - データベース接続 URL（アプリ本体が参照するのはこれ）
#
# [ローカル Docker]
#   postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@localhost:5432/<POSTGRES_DB>?schema=public
#
# [AWS RDS (本番)]
#   postgresql://<user>:<password>@<rds-endpoint>:5432/<dbname>?schema=public&sslmode=require
#   RDS エンドポイントは AWS コンソール > RDS > データベース > 該当インスタンス の
#   「エンドポイント」欄から取得する
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://interview_buddy:your_password_here@localhost:5432/interview_buddy_dev?schema=public"

# -----------------------------------------------------------------------------
# Auth.js (next-auth v5) - 認証
# ※ v5 は AUTH_* 命名規約。NEXTAUTH_* (v4) は参照されないので使わないこと
#
# AUTH_SECRET:
#   セッション・JWT の署名に使うランダム文字列（必須）
#   生成コマンド: npx auth secret
#
# AUTH_URL:
#   アプリの正規 URL。OAuth コールバックの向き先（ローカルは省略可）
#   ローカル: http://localhost:3000
#
# AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET:
#   Google OAuth 2.0 のクライアント認証情報
#   providers: [Google] が自動でこの名前を参照する（src/auth.ts）
#   Google Cloud Console で OAuth 2.0 クライアント ID を作成し設定
#   登録するリダイレクト URI 例:
#     http://localhost:3000/api/auth/callback/google
# -----------------------------------------------------------------------------
AUTH_SECRET=your_auth_secret_here
AUTH_URL=http://localhost:3000

AUTH_GOOGLE_ID=your_google_client_id_here.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your_google_client_secret_here

# -----------------------------------------------------------------------------
# Google Gemini API
#
# GOOGLE_GENERATIVE_AI_API_KEY:
#   https://aistudio.google.com/app/apikey で "Create API key" から取得
#   Vercel AI SDK (@ai-sdk/google) がこの変数名を自動で参照する
#   （src/lib/llm.ts, src/app/api/tts/route.ts で使用）
# -----------------------------------------------------------------------------
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key_here

# -----------------------------------------------------------------------------
# アプリ公開 URL（ブラウザから参照可能な NEXT_PUBLIC_ 変数）
#
# NEXT_PUBLIC_ プレフィックスを付けるとクライアントサイドの JS にバンドルされる
# シークレットな値は絶対に NEXT_PUBLIC_ にしないこと
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
