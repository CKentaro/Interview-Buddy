# -----------------------------
# Environment example (development)
# - 書き換えて `.env.local` にコピーして使ってください
# - 本番用の秘匿値は必ず安全に保管してください
# -----------------------------

# === Database (Postgres) ===
POSTGRES_USER=interview_buddy
POSTGRES_PASSWORD=dev_password_change_in_production
POSTGRES_DB=interview_buddy_dev

# Prisma / Database URL
# Format: postgresql://user:password@host:port/dbname?schema=public
DATABASE_URL="postgresql://interview_buddy:dev_password_change_in_production@localhost:5432/interview_buddy_dev?schema=public"


# === Authentication (NextAuth) ===
# Use NEXTAUTH_* names consistently. AUTH_* are kept as compatibility aliases.
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-key-here"

# Legacy / compatibility (optional)
AUTH_URL="http://localhost:3000"
AUTH_SECRET="your-nextauth-secret-key-here"


# === Google OAuth (for NextAuth) ===
# Create OAuth 2.0 Client ID in Google Cloud Console and set these values.
# Redirect URI example to register: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID="your-google-client-id-here"
GOOGLE_CLIENT_SECRET="your-google-client-secret-here"
# If the client ID is required in browser code, expose a NEXT_PUBLIC var
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-google-client-id-here"


# === APIs / Other keys ===
# Google Generative AI (Gemini) API key
GOOGLE_GENERATIVE_AI_API_KEY="your-gemini-api-key-here"

# -----------------------------
# End of example
# -----------------------------