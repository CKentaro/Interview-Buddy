// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Enum ──────────────────────────────────────────────────────────────────────

// 評価軸（4軸）
enum EvaluationAxis {
  REPRODUCIBILITY // 再現性
  VALUES_JUDGMENT // 価値観 / 判断
  SELF_AWARENESS // 自己認識
  WORLDVIEW // 世界観 / 知的好奇心
}

// 質問種別
enum QuestionType {
  MAIN // 本質問
  FOLLOW_UP // 深掘り質問
}

// 面接セッションの進行状態
enum SessionStatus {
  IN_PROGRESS // 面接中
  PAUSED // 中断中（再開可能）
  COMPLETED // 完了済み
}

// 面接の固定質問構成
enum InterviewLength {
  SHORT
  STANDARD
  LONG
}

// ── Auth.js (next-auth v5) が必要とするテーブル ──────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String? // Auth.js は optional を要求
  email         String    @unique
  emailVerified DateTime? // Auth.js: メール確認日時
  image         String? // Auth.js: プロフィール画像 URL

  // 志望設定（初回オンボーディングで入力し、マイページで編集する）。
  // すべて任意（スキップ可）で、値は careerTaxonomy の大分類 / 小分類。
  // 面接設定画面の「マイページの設定から入力」の初期値として使う。
  industryMajor String?
  industryMinor String?
  jobMajor      String?
  jobMinor      String?

  // オンボーディング（初回のプロフィール確認）を終えた日時。
  // null の間だけ /onboarding へ誘導する。スキップした場合も記録するので、
  // 「何も入力しなかった人」に毎回同じ画面を出すことはない。
  onboardedAt DateTime?

  // Auth.js リレーション
  accounts Account[]
  sessions Session[]

  // アプリ固有リレーション
  interviewSessions InterviewSession[]
  voiceUsages       VoiceUsage[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String // Google OAuth では sub クレームの値
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── アプリ固有モデル ───────────────────────────────────────────────────────────

// 企業マスタ。出典は EDINET コードリスト（金融庁）で、有価証券報告書の提出会社
// （上場企業＋主要な未上場企業）を収録する。日本の全法人ではないため、マスタに
// 無い企業は InterviewSession.companyName の自由入力だけで練習できるようにしてある。
// 投入・更新は prisma/seed.ts（edinetCode で upsert）が行い、アプリからは書き換えない。
model Company {
  id String @id @default(cuid())

  // 取り込みの一意キー。手動追加した企業では null になりうる。
  edinetCode String? @unique
  // 法人番号(13桁)。商号変更などで複数の EDINET コードが同じ番号を持つため一意にしない。
  // 日本の法人を一意に指す公的な番号で、他データとの突き合わせの入口になる。
  // 現状のアプリのクエリでは未使用（索引は将来の名寄せ用）。
  corporateNumber String?
  name            String
  nameKana        String?
  // 正規化した検索キー（normalizeCompanyName の結果）。部分一致検索はこの列で行う。
  searchKey       String
  // 4桁の証券コード。非上場なら null。
  securitiesCode String?
  isListed       Boolean @default(false)
  industryLabel  String?
  // 資本金(百万円)。候補の並び順で企業の規模を測るためだけに使う（表示はしない）。
  capitalMillionYen Int?

  interviewSessions InterviewSession[]

  // 現在の収録件数(約7千件)では単純な部分一致で足りる。全法人へ広げる場合は
  // pg_trgm + GIN インデックスの追加を検討すること。
  @@index([searchKey])
  @@index([corporateNumber])
}

model InterviewSession {
  id              String        @id @default(cuid())
  startedAt       DateTime      @default(now())
  endedAt         DateTime?
  status          SessionStatus @default(IN_PROGRESS)
  // AI 音声読み上げ(TTS)を使う面接か。1 ユーザー 1 日 1 セッションのレート制限は
  // この列（voiceEnabled=true かつ本日開始のセッション数）で判定する。
  voiceEnabled    Boolean         @default(false)
  interviewLength InterviewLength @default(STANDARD)
  // 企業名は常に文字列で保持する（マスタ外の企業でも練習できるようにするため）。
  // companyId はマスタと紐づいたときだけ入る。企業ごとの集計にはこちらを使う。
  companyName     String?
  companyId       String?
  company         Company?        @relation(fields: [companyId], references: [id], onDelete: SetNull)
  industryMajor   String?
  industryMinor   String?
  jobMajor        String?
  jobMinor        String?
  selectionStage  String?
  interviewerType String?
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions       Question[]
  feedback        Feedback?

  @@index([userId, status, startedAt])
  @@index([userId, companyId])
}

model Question {
  id                String           @id @default(cuid())
  type              QuestionType
  content           String
  displayOrder      Int
  depthCount        Int              @default(0)
  primaryAxis       EvaluationAxis?
  sessionId         String
  session           InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  parentQuestionId  String?
  parentQuestion    Question?        @relation("QuestionFollowUps", fields: [parentQuestionId], references: [id], onDelete: Cascade)
  followUpQuestions Question[]       @relation("QuestionFollowUps")
  answer            Answer?
}

// AI 音声(TTS)の利用ログ。音声あり面接を開始するたびに 1 行記録する。
// InterviewSession とは意図的に無関係にし、面接を中断（セッション削除）しても
// 消えないようにする（中断でレート枠が復活する抜け穴を塞ぐ）。
//
// usageDate は JST の "YYYY-MM-DD"。@@unique([userId, usageDate]) により
// 1 ユーザー 1 日 1 行しか作れず、同時リクエスト(TOCTOU)でも DB が 2 回目の
// 消費を弾く（＝実質のレート上限は 1/日）。上限を増やす場合はこの制約の見直しが必要。
model VoiceUsage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  usageDate String
  createdAt DateTime @default(now())

  @@unique([userId, usageDate])
  @@index([userId, createdAt])
}

model Answer {
  id         String   @id @default(cuid())
  content    String
  questionId String   @unique
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model Feedback {
  id             String           @id @default(cuid())
  overallComment String
  sessionId      String           @unique
  session        InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  axisFeedbacks  AxisFeedback[]
}

model AxisFeedback {
  id         String         @id @default(cuid())
  axis       EvaluationAxis
  comment    String
  feedbackId String
  feedback   Feedback       @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
}
