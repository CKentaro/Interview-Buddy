// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Enum ──────────────────────────────────────────────────────────────────────

// 評価軸（4軸）
enum EvaluationAxis {
  REPRODUCIBILITY // 再現性
  VALUES_JUDGMENT // 価値観 / 判断
  SELF_AWARENESS // 自己認識
  WORLDVIEW // 世界観 / 知的好奇心
}

// 質問種別
enum QuestionType {
  MAIN // 本質問
  FOLLOW_UP // 深掘り質問
}

// 面接セッションの進行状態
enum SessionStatus {
  IN_PROGRESS // 面接中
  PAUSED // 中断中（再開可能）
  COMPLETED // 完了済み
}

// ── Auth.js (next-auth v5) が必要とするテーブル ──────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String? // Auth.js は optional を要求
  email         String    @unique
  emailVerified DateTime? // Auth.js: メール確認日時
  image         String? // Auth.js: プロフィール画像 URL

  // Auth.js リレーション
  accounts Account[]
  sessions Session[]

  // アプリ固有リレーション
  interviewSessions InterviewSession[]
  voiceUsages       VoiceUsage[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String // Google OAuth では sub クレームの値
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── アプリ固有モデル ───────────────────────────────────────────────────────────

model InterviewSession {
  id              String        @id @default(cuid())
  startedAt       DateTime      @default(now())
  endedAt         DateTime?
  status          SessionStatus @default(IN_PROGRESS)
  // AI 音声読み上げ(TTS)を使う面接か。1 ユーザー 1 日 1 セッションのレート制限は
  // この列（voiceEnabled=true かつ本日開始のセッション数）で判定する。
  voiceEnabled    Boolean       @default(false)
  companyName     String?
  industryMajor   String?
  industryMinor   String?
  jobMajor        String?
  jobMinor        String?
  selectionStage  String?
  interviewerType String?
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions       Question[]
  feedback        Feedback?

  @@index([userId, status, startedAt])
}

model Question {
  id                String           @id @default(cuid())
  type              QuestionType
  content           String
  displayOrder      Int
  depthCount        Int              @default(0)
  primaryAxis       EvaluationAxis?
  sessionId         String
  session           InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  parentQuestionId  String?
  parentQuestion    Question?        @relation("QuestionFollowUps", fields: [parentQuestionId], references: [id], onDelete: Cascade)
  followUpQuestions Question[]       @relation("QuestionFollowUps")
  answer            Answer?
}

// AI 音声(TTS)の利用ログ。音声あり面接を開始するたびに 1 行記録する。
// InterviewSession とは意図的に無関係にし、面接を中断（セッション削除）しても
// 消えないようにする（中断でレート枠が復活する抜け穴を塞ぐ）。
//
// usageDate は JST の "YYYY-MM-DD"。@@unique([userId, usageDate]) により
// 1 ユーザー 1 日 1 行しか作れず、同時リクエスト(TOCTOU)でも DB が 2 回目の
// 消費を弾く（＝実質のレート上限は 1/日）。上限を増やす場合はこの制約の見直しが必要。
model VoiceUsage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  usageDate String
  createdAt DateTime @default(now())

  @@unique([userId, usageDate])
  @@index([userId, createdAt])
}

model Answer {
  id         String   @id @default(cuid())
  content    String
  questionId String   @unique
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model Feedback {
  id             String           @id @default(cuid())
  overallComment String
  sessionId      String           @unique
  session        InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  axisFeedbacks  AxisFeedback[]
}

model AxisFeedback {
  id         String         @id @default(cuid())
  axis       EvaluationAxis
  comment    String
  feedbackId String
  feedback   Feedback       @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
}
