generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String             @id @default(cuid())
  name              String?
  email             String             @unique
  emailVerified     DateTime?
  image             String?
  accounts          Account[]
  interviewSessions InterviewSession[]
  sessions          Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model InterviewSession {
  id              String     @id @default(cuid())
  startedAt       DateTime   @default(now())
  endedAt         DateTime?
  companyName     String?
  industryMajor   String?
  industryMinor   String?
  jobMajor        String?
  jobMinor        String?
  selectionStage  String?
  interviewerType String?
  userId          String
  feedback        Feedback?
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions       Question[]
}

model Question {
  id                String           @id @default(cuid())
  type              QuestionType
  content           String
  displayOrder      Int
  depthCount        Int              @default(0)
  primaryAxis       EvaluationAxis?
  sessionId         String
  parentQuestionId  String?
  answer            Answer?
  parentQuestion    Question?        @relation("QuestionFollowUps", fields: [parentQuestionId], references: [id], onDelete: Cascade)
  followUpQuestions Question[]       @relation("QuestionFollowUps")
  session           InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model Answer {
  id         String   @id @default(cuid())
  content    String
  questionId String   @unique
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model Feedback {
  id              String           @id @default(cuid())
  overallComment  String
  sessionId       String           @unique
  axisEvaluations AxisEvaluation[]
  session         InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model AxisEvaluation {
  id         String         @id @default(cuid())
  axis       EvaluationAxis
  comment    String
  feedbackId String
  feedback   Feedback       @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
}

enum EvaluationAxis {
  REPRODUCIBILITY
  VALUES_JUDGMENT
  SELF_AWARENESS
  WORLDVIEW
}

enum QuestionType {
  MAIN
  FOLLOW_UP
}
